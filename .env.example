# Google AI Studio API Key (Free Tier - Gemini Flash access)
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Selection
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Vector DB Settings (Local Persistent Qdrant)
QDRANT_PATH=./data/qdrant_db
QDRANT_COLLECTION_NAME=nvda_documents

# Database Settings
DATABASE_URL=sqlite:///./data/stock_data/stocks.db
NVDA_CSV_PATH=./data/stock_data/NVDA.csv

# Optional Fallback Settings
OLLAMA_BASE_URL=http://localhost:11434
USE_LOCAL_EMBEDDING_FALLBACK=false

# Langfuse Observability (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
